/dts-v1/;

#include <dt-bindings/net/ti-dp83867.h>
#include "imx93-phyflex-fpsc-g-som.dtsi"

/ {
	model = "PHYTEC phyFLEX-i.MX 93 Libra RDK";
	compatible = "phytec,imx93-phyflex-libra-rdk", "phytec,imx93-phyflex-fpsc-g",
		     "fsl,imx93";

	aliases {
		mmc0 = &usdhc1;
		mmc1 = &usdhc2;
	};

	chosen {
		stdout-path = &lpuart1;
	};

	curr_sens_som_in: current-sense-som-in {
		compatible = "current-sense-amplifier";
		#io-channel-cells = <0>;
		io-channels = <&adc1 0>;
		sense-gain-div = <3>;
		sense-gain-mult = <100>;
		sense-resistor-micro-ohms = <4000>;
	};

	curr_sens_som_in_ext: current-sense-som-in-ext {
		compatible = "current-sense-amplifier";
		#io-channel-cells = <0>;
		io-channels = <&adc2 0>;
		sense-gain-div = <15>;
		sense-gain-mult = <1400>;
		sense-resistor-micro-ohms = <4000>;
	};

	curr_sens_vdd_1v8_ext: current-sense-vdd-1v8-ext {
		compatible = "current-sense-amplifier";
		#io-channel-cells = <0>;
		io-channels = <&adc2 6>;
		sense-gain-mult = <100>;
		sense-resistor-micro-ohms = <4000>;
	};

	curr_sens_vdd_3v3_ext: current-sense-vdd-3v3-ext {
		compatible = "current-sense-amplifier";
		#io-channel-cells = <0>;
		io-channels = <&adc2 4>;
		sense-gain-mult = <100>;
		sense-resistor-micro-ohms = <4000>;
	};

	curr_sens_vdd_5v0: current-sense-vdd-5v0 {
		compatible = "current-sense-amplifier";
		#io-channel-cells = <0>;
		io-channels = <&adc1 2>;
		sense-gain-div = <3>;
		sense-gain-mult = <100>;
		sense-resistor-micro-ohms = <4000>;
	};

	curr_sens_vdd_5v0_ext: current-sense-vdd-5v0-ext {
		compatible = "current-sense-amplifier";
		#io-channel-cells = <0>;
		io-channels = <&adc2 2>;
		sense-gain-div = <15>;
		sense-gain-mult = <1400>;
		sense-resistor-micro-ohms = <4000>;
	};

	iio-hwmon {
		compatible = "iio-hwmon";
		io-channels = <&curr_sens_vdd_1v8_ext>, <&adc2 7>,
				<&curr_sens_vdd_3v3_ext>, <&adc2 5>,
				<&curr_sens_vdd_5v0>, <&volt_sens_vdd_5v0>,
				<&curr_sens_vdd_5v0_ext>, <&volt_sens_vdd_5v0_ext>,
				<&curr_sens_som_in>, <&volt_sens_som_in>,
				<&curr_sens_som_in_ext>, <&volt_sens_som_in_ext>;
	};

	reg_vdd_12v0: regulator-vdd-12v0 {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <12000000>;
		regulator-min-microvolt = <12000000>;
		regulator-name = "VDD_12V0";
	};

	reg_vdd_1v8: regulator-vdd-1v8 {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-name = "VDD_1V8";
	};

	reg_vdd_3v3: regulator-vdd-3v3 {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-name = "VDD_3V3";
	};

	reg_vdd_5v0: regulator-vdd-5v0 {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "VDD_5V0";
	};

	reg_vdd_5v0_ref: regulator-vdd-5v0-ref {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "VDD_5V0_REF";
	};

	volt_sens_som_in: voltage-sense-som-in {
		compatible = "voltage-divider";
		#io-channel-cells = <0>;
		io-channels = <&adc1 1>;
		output-ohms = <100>;
		full-ohms = <346>;
	};

	volt_sens_som_in_ext: voltage-sense-som-in-ext {
		compatible = "voltage-divider";
		#io-channel-cells = <0>;
		io-channels = <&adc2 1>;
		output-ohms = <280>;
		full-ohms = <346>;
	};

	volt_sens_vdd_5v0: voltage-sense-vdd-5v0 {
		compatible = "voltage-divider";
		#io-channel-cells = <0>;
		io-channels = <&adc1 3>;
		output-ohms = <100>;
		full-ohms = <346>;
	};

	volt_sens_vdd_5v0_ext: voltage-sense-vdd-5v0-ext {
		compatible = "voltage-divider";
		#io-channel-cells = <0>;
		io-channels = <&adc2 3>;
		output-ohms = <280>;
		full-ohms = <346>;
	};
};

/* ADC */
&adc1 {
	status = "okay";
};

/* FPSC I2C2 */
&lpi2c1 {
	status = "okay";

	gpio_expander1: gpio@21 {
		compatible = "ti,tcal6416";
		reg = <0x21>;
		interrupt-controller;
		interrupt-parent = <&gpio2>;
		interrupts = <22 IRQ_TYPE_LEVEL_LOW>;
		#interrupt-cells = <2>;
		#gpio-cells = <2>;
		gpio-controller;
		gpio-line-names = "VCONN_nFAULT", "CSI1_CTRL1", "CSI1_CTRL3",
				  "CSI1_CTRL4", "USB-C_nINT/AUDIO_AC",
				  "CSI2_CTRL1", "CSI2_CTRL3", "CSI2_CTRL4",
				  "CLK_EN_AV", "W_nDISABLE1", "W_nDISABLE2",
				  "PCIE1_nWAKE", "PCIE2_nWAKE", "UART1_nWAKE",
				  "UART1_BT_RS_SEL", "UART1_RS232_485_SEL";
	};
};

/* FPSC I2C3 */
&lpi2c2 {
	status = "okay";

	gpio_expander2: gpio@21 {
		compatible = "ti,tcal6416";
		reg = <0x21>;
		interrupt-controller;
		interrupt-parent = <&gpio2>;
		interrupts = <23 IRQ_TYPE_LEVEL_LOW>;
		#interrupt-cells = <2>;
		#gpio-cells = <2>;
		gpio-controller;
		gpio-line-names = "CAN1_STBY", "CAN2_STBY", "CAN3_STBY",
				  "KEY-E_nALERT", "KEY-M_nALERT",
				  "SDIO_nWAKE", "SDIO_nRESET", "HDMI_EN",
				  "RTC_nINT", "LVDS1_BL_EN", "SFP_TX_FAULT",
				  "SFP_TX_DISABLE", "SFP_MOD_ABS", "SFP_RS0",
				  "SFP_RX_LOSS", "SFP_RS1";
	};

	led-controller@62 {
		compatible = "nxp,pca9633";
		reg = <0x62>;
		#address-cells = <1>;
		#size-cells = <0>;

		led@0 {
			reg = <0>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
		};

		led@1 {
			reg = <1>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
		};

		led@2 {
			reg = <2>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
		};
	};
};

/* FPSC ENET2 */
&eqos {
	status = "okay";
};

&mdio {
	ethphy1: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		interrupt-parent = <&gpio4>;
		interrupts = <1 IRQ_TYPE_LEVEL_LOW>;
		ti,clk-output-sel = <DP83867_CLK_O_SEL_OFF>;
		ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		ti,rx-internal-delay = <DP83867_RGMIIDCTL_1_50_NS>;
		ti,tx-internal-delay = <DP83867_RGMIIDCTL_1_75_NS>;
	};
};

/* FPSC SPI1 */
&lpspi6 {
	status = "okay";

	/* ADC */
	adc2: adc2@0 {
		compatible = "microchip,mcp3208";
		reg = <0>;
		spi-max-frequency = <1000000>;
		vref-supply = <&reg_vdd_5v0_ref>;
		#io-channel-cells = <1>;
	};
};

/* Console */
&lpuart1 {
	status = "okay";
};

/* SD-Card */
&usdhc2 {
	status = "okay";
};
