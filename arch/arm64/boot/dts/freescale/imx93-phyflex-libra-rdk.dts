/dts-v1/;

#include <dt-bindings/net/ti-dp83867.h>
#include "imx93-phyflex-fpsc-g-som.dtsi"

/ {
	model = "PHYTEC phyFLEX-i.MX 93 Libra RDK";
	compatible = "phytec,imx93-phyflex-libra-rdk", "phytec,imx93-phyflex-fpsc-g",
		     "fsl,imx93";

	aliases {
		mmc0 = &usdhc1;
		mmc1 = &usdhc2;
	};

	chosen {
		stdout-path = &lpuart1;
	};
};

/* FPSC I2C2 */
&lpi2c1 {
	status = "okay";
};

/* FPSC I2C3 */
&lpi2c2 {
	status = "okay";
};

/* FPSC ENET2 */
&eqos {
	status = "okay";
};

&mdio {
	ethphy1: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		interrupt-parent = <&gpio4>;
		interrupts = <1 IRQ_TYPE_LEVEL_LOW>;
		ti,clk-output-sel = <DP83867_CLK_O_SEL_OFF>;
		ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		ti,rx-internal-delay = <DP83867_RGMIIDCTL_1_50_NS>;
		ti,tx-internal-delay = <DP83867_RGMIIDCTL_1_75_NS>;
	};
};

/* Console */
&lpuart1 {
	status = "okay";
};

/* SD-Card */
&usdhc2 {
	status = "okay";
};
